# -----------------------------------------------
# Google Gemini API Key (FREE — no credit card)
# Get yours at: https://aistudio.google.com
# Click "Get API Key" → Create API Key → Copy it
# -----------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Server config
PORT=3001
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your-secret-key-change-in-production

# Your frontend URL (for CORS — change in production)
FRONTEND_URL=http://localhost:5173

# Optional override for Gemini model name
# Default: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# OpenRouter API Key (Allows accessing free Llama models when other keys fail)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Google OAuth Configuration (for Google Login)
# Set up a project in Google Cloud Console: https://console.cloud.google.com/
# Add client ID and secret here without any quotes ("")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

